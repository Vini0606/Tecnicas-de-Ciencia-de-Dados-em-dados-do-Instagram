APIFY_API_TOKEN=your_token_here
# Usada só por scripts/refine_topics.py (src/modeling/gemini_refiner.py), no
# refinamento manual dos rótulos de tópico via Gemini. O notebook 03 não
# dispara mais essa etapa -- só lê o resultado (ver ADR 0003).
API_GEMINI=your_gemini_api_key_here
DATA_DIR=data
RESULTS_LIMIT=30
S3_BUCKET=your-bucket-name
S3_BRONZE_PREFIX=bronze/
S3_SILVER_PREFIX=silver/
S3_GOLD_PREFIX=gold/
# Janela (em dias) da comparação "atual vs. anterior" por data de publicação
# usada pelo Radar de crise e pelo Resumo (ADR 0025 / issue #153) -- lida
# diretamente em dashboard/core/deltas.py.
JANELA_ALERTA_NEGATIVIDADE_DIAS=7
# Dataset PRIVADO no Hugging Face com as Coletas versionadas (Snapshot = Bronze,
# Silver, Gold e manifesto.json; a main guarda a Coleta vigente e as anteriores
# ficam em tags -- ADR 0039). Usado por `coleta.py publicar|baixar|listar|restaurar`
# e pela Lambda rebuild. Token fine-grained com acesso só a esse dataset;
# nunca versionar o valor real.
HF_TOKEN=your_hf_token_here
HF_DATASET_REPO=your-hf-user/governadores-instagram-medallion

# Opcional: dataset privado separado para o dashboard (ADR 0036); ele baixa so
# Silver + Gold + manifesto. Sem ele, o dashboard usa o HF_DATASET_REPO acima.
# HF_DATASET_REPO_PUBLICACAO=your-hf-user/dashboard-medallion
# Tag ou commit do dataset a exibir no dashboard; sem ela, usa a main (Coleta vigente).
# HF_DATASET_REVISAO=

# Senha de acesso ao dashboard (ADR 0037). Obrigatoria fora do localhost:
# sem ela o app publicado fica bloqueado. No Streamlit Cloud, defina nos Secrets.
# APP_PASSWORD=troque-por-uma-senha-longa
