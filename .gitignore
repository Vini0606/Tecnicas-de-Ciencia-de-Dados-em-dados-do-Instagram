# Python cache
__pycache__/
*.py[cod]
*.pyc
.coverage

# Arquivo com Variáveis de Ambiente
.env
*.pbix
*.png

# Exceção: as figuras dos relatórios são artefatos do trabalho.
# Sem elas o README não exibe os resultados e o TCC em LaTeX não compila.
!reports/figures/*.png
!reports/academic/Figuras/*.png

# ambiente virtual
.venv/

# Terraform (infra/) -- estado e variáveis locais nunca vão pro git;
# terraform.tfvars pode conter o apify_api_token em texto plano.
# .terraform.lock.hcl fica de fora do gitignore de propósito: é um lockfile
# de versão de provider, deve ser commitado.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
infra/*.tfplan

# Medallion data
data/raw/
data/bronze/
data/silver/
data/gold/
data/model_checkpoints/
!data/bronze/**/.gitkeep
!data/silver/**/.gitkeep
!data/gold/**/.gitkeep

# Landing zone (JSON bruto por run_id, ver ADR 0011/0014) e artefatos dos
# scripts de extracao/calibracao Apify -- nunca gerados em git, so em disco.
data/landing/
data/backfill/
data/calibration/

# Backup local de data/ antes de simular ambiente limpo (issue #33) -- nunca
# deve ser versionado, mesmo que criado fora de data/.
data_backup_*/